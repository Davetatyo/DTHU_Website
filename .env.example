# Másold le .env.local néven, és töltsd ki (Vercelen ugyanezeket add meg az Environment Variables alatt).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Titkos! Csak a szerveren használjuk, soha ne kerüljön NEXT_PUBLIC_ változóba.
SUPABASE_SERVICE_ROLE_KEY=

# Az oldal nyilvános címe (perjel nélkül). Helyben: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Ezek a Discord felhasználónevek első belépéskor automatikusan adminok lesznek (vesszővel elválasztva)
BOOTSTRAP_ADMIN_DISCORD=davetatyo

# Discord csatorna → Integrációk → Webhookok → Új webhook → URL másolása
DISCORD_WEBHOOK_URL=

# Tetszőleges hosszú véletlen szöveg; a Supabase emlékeztető időzítő ezzel hívja az oldalt
CRON_SECRET=
